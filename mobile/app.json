{
  "expo": {
    "name": "SheshHisab",
    "slug": "sheshhisab",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "sheshhisab",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sheshhisab.wallet",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Confirm payments with Face ID.",
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "com.sheshhisab.wallet",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F7F5"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan payment QR codes."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Confirm payments with Face ID."
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#F4F7F5",
          "dark": {
            "image": "./assets/splash.png",
            "backgroundColor": "#081A12"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
