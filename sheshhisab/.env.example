# Shared by Convex and Vercel. Use the same 32+ character random value.
AUTH_EMAIL_RELAY_SECRET=

# Convex only. Point this to the deployed Vercel route.
AUTH_EMAIL_RELAY_URL=https://example.com/api/internal/auth-email

# Vercel only. Brevo SMTP relay credentials and verified sender.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
AUTH_EMAIL_FROM=SheshHisab <wallet@example.com>
